{
  "direct_tools": {
    "endpoints": [
      {
        "method": "POST",
        "params": {
          "url": "required"
        },
        "path": "direct/landing-audit",
        "price_rub": 39,
        "returns": "score 1-10, summary, strengths, problems, recommendations"
      },
      {
        "method": "POST",
        "params": {
          "url": "optional",
          "utp": "optional (url and/or utp required)"
        },
        "path": "direct/ads-generate",
        "price_rub": 49,
        "returns": "groups[].combinatorial.titles/texts + keywords"
      },
      {
        "method": "POST",
        "params": {
          "url": "required"
        },
        "path": "direct/sitelinks",
        "price_rub": 29,
        "returns": "8 sitelinks (title<=30, description<=60, href_path) + 6 callouts (<=25) + display_path + tips"
      },
      {
        "method": "POST",
        "params": {
          "keywords": "required array (max 10)",
          "region_ids": "optional",
          "target_budget": "optional"
        },
        "path": "direct/forecast",
        "price_rub": 49,
        "returns": "scenarios[] (budget_rub, clicks, leads, cpa_rub) + assumptions"
      },
      {
        "method": "POST",
        "params": {
          "days": "optional 1..90 (default 30)",
          "force": "optional bool"
        },
        "path": "campaigns/{id}/report",
        "price_rub": 99,
        "returns": "client-ready report: headline, executive_summary, kpi[], what_works, what_to_fix, next_steps, client_message"
      },
      {
        "method": "POST",
        "params": {
          "days": "optional 1..90 (default 30)",
          "force": "optional bool"
        },
        "path": "campaigns/{id}/waste",
        "price_rub": 49,
        "returns": "waste_keywords, waste_placements, potential_savings_rub, recommendations"
      },
      {
        "method": "POST",
        "params": {
          "days": "optional 1..90 (default 30)",
          "force": "optional bool"
        },
        "path": "campaigns/{id}/search-queries",
        "price_rub": 39,
        "returns": "negative_keywords, new_keywords, insights, summary"
      }
    ],
    "note": "Direct specialist tools: ready-made Yandex Direct analytics and assets. Pay-per-call from balance, auto-refund on failure. Campaign tools cache results for 24h per (campaign, days); pass force=true for a fresh paid run."
  },
  "endpoints": {
    "GET /api/agent/autopilot/log": "Autopilot action history",
    "GET /api/agent/balance": "Check balance",
    "GET /api/agent/campaigns": "List Yandex Direct campaigns",
    "GET /api/agent/campaigns/{id}": "Campaign details",
    "GET /api/agent/generation/{id}/status": "Check generation status",
    "GET /api/agent/prices": "Full price list",
    "GET /api/agent/voice/list": "Suno Voice: list custom voices",
    "GET /api/agent/voice/status": "Suno Voice: check voice creation status",
    "GET /api/agent/voice/validate-info": "Suno Voice: get verification phrase",
    "GET /api/agent/voiceover/long/{id}": "Long voiceover (el-tts-turbo, prompt > 5000 chars) progress and result",
    "GET /api/agent/voices": "ElevenLabs voice catalog",
    "GET /api/agent/yandex": "Yandex credentials + capabilities + API endpoints",
    "GET /api/agent/yandex/counters/{id}/goals": "Metrika goals for counter",
    "POST /api/agent/autopilot/config": "Get/update autopilot config",
    "POST /api/agent/autopilot/run": "Run autopilot cycle for campaign",
    "POST /api/agent/campaigns/{id}/analyze": "AI performance analysis",
    "POST /api/agent/campaigns/{id}/optimize": "AI optimization advice",
    "POST /api/agent/campaigns/{id}/sync": "Sync stats from Yandex",
    "POST /api/agent/creative-variants": "Generate ad text variants",
    "POST /api/agent/generate": "Start generation. Pass strict=true to reject bad params before debit.",
    "POST /api/agent/generate/estimate": "Dry-run: validate + price a /generate body without spending",
    "POST /api/agent/keywords-suggest": "WordStat keyword enrichment",
    "POST /api/agent/safety-check": "Pre-action risk assessment",
    "POST /api/agent/upload-media": "Upload a file, get a stable URL",
    "POST /api/agent/voice/generate": "Suno Voice: submit recorded verification audio",
    "POST /api/agent/voice/regenerate": "Suno Voice: regenerate expired verification phrase",
    "POST /api/agent/voice/validate": "Suno Voice: submit source audio for custom voice creation",
    "POST /api/agent/webhook-test": "Send a signed test event to callback_url"
  },
  "features": {
    "auto_refund_on_error": "If provider or pipeline fails after start, the generation cost is refunded automatically.",
    "dry_run": "POST /generate/estimate validates and prices a request without spending money.",
    "persistence": "Generation continues server-side even if polling stops.",
    "pre_charge_validation": "Media URL params are HEAD-checked before any debit. Bad URL returns HTTP 422 media_validation_failed, no charge.",
    "strict_mode": "Pass strict=true to reject unknown/incompatible params before debit. Without strict they are reported as ignored_params.",
    "webhook_delivery": "Pass callback_url in /generate. We POST generation.complete or generation.error with X-Vibe-Signature HMAC. Test with POST /api/agent/webhook-test."
  },
  "getting_started": {
    "auth": "Send header: Authorization: Bearer <your_token>. Get a key at https://lk.vibemarketolog.ru/agent.",
    "base_url": "https://lk.vibemarketolog.ru/api/agent",
    "docs": "https://lk.vibemarketolog.ru/docs/agent-api",
    "flow": [
      "1. GET /me — confirm the key works and check daily_spend_limit.",
      "2. GET /balance — check available rubles.",
      "3. GET /capabilities — discover models and params.",
      "4. POST /upload-media — upload media and get a stable URL.",
      "5. POST /generate/estimate — dry-run without spending.",
      "6. POST /generate with strict=true — start generation.",
      "7. Poll GET /generation/{id}/status or pass callback_url."
    ],
    "golden_rules": [
      "Always GET /capabilities for live required/optional params.",
      "Use POST /upload-media for stable URLs.",
      "Use strict=true and/or /generate/estimate to avoid paying for malformed requests."
    ],
    "image_to_video": {
      "grok-itv-10|20|30": "image_urls: [\"...\"]",
      "kling-3.0-std|pro": "image_urls: [\"...\"]",
      "motion-control-720p|1080p": "character_image_url + reference_video_url",
      "note": "image_input is for type=image only. Video models need their own source fields.",
      "seedance-2|seedance-2-fast": "first_frame_url: \"...\"",
      "veo3_fast|veo3.1|veo3": "image_urls: [\"...\"] + generation_type: \"image-to-video\""
    },
    "quickstart": "https://lk.vibemarketolog.ru/docs/agent-quickstart",
    "verify_key": "GET /api/agent/me"
  },
