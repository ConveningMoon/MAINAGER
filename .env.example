# Copy to .env and fill in. .env is never committed.

# --- Vibe Agent API ---
# Token issued in the personal cabinet. Format: oc_...
VIBE_API_TOKEN=oc_replace_me
VIBE_API_BASE_URL=https://lk.vibemarketolog.ru/api/agent
VIBE_HTTP_TIMEOUT_S=30

# --- spend ceilings enforced locally, before the network ---
# Hard stop for a single plan and for a rolling 24h window, in rubles.
MAINAGER_PLAN_CEILING_RUB=50
MAINAGER_DAILY_CEILING_RUB=100

# --- local paths ---
MAINAGER_DATA_DIR=data

# --- logging ---
# text | json
MAINAGER_LOG_FORMAT=text
MAINAGER_LOG_LEVEL=INFO
